<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Atala</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Atala reads your runs and their heart rate from Apple Health so your coach can adapt your plan.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Atala only reads from Apple Health. It does not add or change any of your Health data.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Atala uses your location to record your run, even when the screen is locked.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Atala uses your location to record the distance, pace and route of your run.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>launch_logo</string>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.atala.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>atala</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
